{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combat Traces element",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "priority": {
      "type": "integer",
      "minimum": -10000,
      "maximum": 10000
    },
    "conditions": {
      "$ref": "#/$defs/condition"
    },
    "trail": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "impact": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "particle": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#?[0-9a-fA-F]{6}$"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "condition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
        },
        "item_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
        },
        "item_tag": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
        },
        "enchantment": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
        },
        "component": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
        },
        "effect": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
        },
        "category": {
          "type": "string"
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "and": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "or": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    }
  }
}
