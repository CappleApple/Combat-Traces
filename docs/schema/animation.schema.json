{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combat Traces animation override",
  "type": "object",
  "properties": {
    "animation": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
    },
    "trail_window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "sample_multiplier": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 3
    }
  },
  "additionalProperties": true
}
